# ==============================================================================
# Genius AI - Optional Environment Configuration
# ==============================================================================
# Genius runs 100% locally by default on CPU/Edge (no keys required).
# If you wish to enable cloud escalation providers, set keys below:

# Optional: Anthropic Claude 3.5 Sonnet / Haiku
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: OpenAI GPT-4o / GPT-4o-mini
# OPENAI_API_KEY=sk-...

# Optional: Local Ollama endpoint (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
